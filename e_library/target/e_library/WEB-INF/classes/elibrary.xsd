<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" 
           elementFormDefault="qualified">

    <!-- Root Element -->
    <xs:element name="eLibrary">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="educationLevel" type="EducationLevelType" 
                            maxOccurs="unbounded"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

    <!-- Education Level Complex Type -->
    <xs:complexType name="EducationLevelType">
        <xs:sequence>
            <xs:element name="n" type="xs:string"/>
            <xs:element name="duration" type="xs:string"/>
            <xs:element name="grades" type="GradesType" minOccurs="0"/>
            <xs:element name="specializations" type="SpecializationsType" minOccurs="0"/>
            <xs:element name="types" type="TypesType" minOccurs="0"/>
            <xs:element name="fields" type="FieldsType" minOccurs="0"/>
            <xs:element name="books" type="BooksType"/>
        </xs:sequence>
        <xs:attribute name="id" type="xs:ID" use="required"/>
        <xs:attribute name="code" type="EducationCodeType" use="required"/>
    </xs:complexType>

    <!-- Education Code Enumeration -->
    <xs:simpleType name="EducationCodeType">
        <xs:restriction base="xs:string">
            <xs:enumeration value="PRIMARY"/>
            <xs:enumeration value="PREPARATORY"/>
            <xs:enumeration value="SECONDARY"/>
            <xs:enumeration value="LICENCE"/>
            <xs:enumeration value="MASTER"/>
            <xs:enumeration value="DOCTORATE"/>
        </xs:restriction>
    </xs:simpleType>

    <!-- Grades Complex Type -->
    <xs:complexType name="GradesType">
        <xs:sequence>
            <xs:element name="grade" maxOccurs="unbounded">
                <xs:complexType>
                    <xs:simpleContent>
                        <xs:extension base="xs:string">
                            <xs:attribute name="number" type="xs:positiveInteger" use="required"/>
                        </xs:extension>
                    </xs:simpleContent>
                </xs:complexType>
            </xs:element>
        </xs:sequence>
    </xs:complexType>

    <!-- Specializations Complex Type -->
    <xs:complexType name="SpecializationsType">
        <xs:sequence>
            <xs:element name="specialization" maxOccurs="unbounded">
                <xs:complexType>
                    <xs:simpleContent>
                        <xs:extension base="xs:string">
                            <xs:attribute name="code" type="xs:string" use="required"/>
                        </xs:extension>
                    </xs:simpleContent>
                </xs:complexType>
            </xs:element>
        </xs:sequence>
    </xs:complexType>

    <!-- Types Complex Type (for Master's) -->
    <xs:complexType name="TypesType">
        <xs:sequence>
            <xs:element name="type" maxOccurs="unbounded">
                <xs:complexType>
                    <xs:simpleContent>
                        <xs:extension base="xs:string">
                            <xs:attribute name="code" type="xs:string" use="required"/>
                        </xs:extension>
                    </xs:simpleContent>
                </xs:complexType>
            </xs:element>
        </xs:sequence>
    </xs:complexType>

    <!-- Fields Complex Type -->
    <xs:complexType name="FieldsType">
        <xs:sequence>
            <xs:element name="field" maxOccurs="unbounded">
                <xs:complexType>
                    <xs:simpleContent>
                        <xs:extension base="xs:string">
                            <xs:attribute name="code" type="xs:string" use="required"/>
                        </xs:extension>
                    </xs:simpleContent>
                </xs:complexType>
            </xs:element>
        </xs:sequence>
    </xs:complexType>

    <!-- Books Complex Type -->
    <xs:complexType name="BooksType">
        <xs:sequence>
            <xs:element name="book" type="BookType" maxOccurs="unbounded"/>
        </xs:sequence>
    </xs:complexType>

    <!-- Book Complex Type -->
    <xs:complexType name="BookType">
        <xs:sequence>
            <xs:element name="title" type="xs:string"/>
            <xs:element name="subject" type="xs:string"/>
            <xs:element name="author" type="xs:string"/>
            <xs:element name="isbn" type="ISBNType"/>
            <xs:element name="publicationYear" type="YearType"/>
            <xs:element name="format" type="FormatType"/>
            <xs:element name="language" type="LanguageType"/>
        </xs:sequence>
        <xs:attribute name="id" type="xs:ID" use="required"/>
        <xs:attribute name="specialization" type="xs:string" use="optional"/>
        <xs:attribute name="field" type="xs:string" use="optional"/>
        <xs:attribute name="type" type="xs:string" use="optional"/>
    </xs:complexType>

    <!-- ISBN Simple Type with Pattern -->
    <xs:simpleType name="ISBNType">
        <xs:restriction base="xs:string">
            <xs:pattern value="978-[0-9]{4}-[0-9]{3}-[0-9]{2}-[0-9]"/>
        </xs:restriction>
    </xs:simpleType>

    <!-- Year Simple Type -->
    <xs:simpleType name="YearType">
        <xs:restriction base="xs:integer">
            <xs:minInclusive value="1900"/>
            <xs:maxInclusive value="2100"/>
        </xs:restriction>
    </xs:simpleType>

    <!-- Format Enumeration -->
    <xs:simpleType name="FormatType">
        <xs:restriction base="xs:string">
            <xs:enumeration value="PDF"/>
            <xs:enumeration value="EPUB"/>
            <xs:enumeration value="MOBI"/>
            <xs:enumeration value="HTML"/>
            <xs:enumeration value="DOCX"/>
        </xs:restriction>
    </xs:simpleType>

    <!-- Language Enumeration -->
    <xs:simpleType name="LanguageType">
        <xs:restriction base="xs:string">
            <xs:enumeration value="Arabic"/>
            <xs:enumeration value="French"/>
            <xs:enumeration value="English"/>
            <xs:enumeration value="Bilingual"/>
        </xs:restriction>
    </xs:simpleType>

</xs:schema>